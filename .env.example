# The email of the resources' owner, added as the owner tag
# RESOURCE_OWNER=

# Deployment token (optional - deploy.sh reads it from the Static Web App)
# SWA_DEPLOYMENT_TOKEN=

# Terraform remote state (optional - provision.sh creates and names it per project)
# TFSTATE_RESOURCE_GROUP=
# TFSTATE_STORAGE_ACCOUNT=
# TFSTATE_CONTAINER=tfstate
# TFSTATE_KEY=terraform.tfstate

# GitHub repository the service principal trusts (optional - create-service-principal.sh
# reads it from the origin remote)
# GITHUB_REPOSITORY=<owner>/<repo>

# Service principal (optional locally - `az login` is used when these are empty)
# ARM_CLIENT_ID=
# ARM_CLIENT_SECRET=
# ARM_TENANT_ID=
# ARM_SUBSCRIPTION_ID=
